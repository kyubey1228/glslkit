# frozen_string_literal: true

require_relative "lib/glslkit/webgl/embed"

namespace :glslkit do
  desc "Generate embeddable Ruby constants (manifest + source maps) from .vert/.frag pairs. " \
    "Usage: rake glslkit:embed[shaders_dir,out_dir]"
  task :embed, [:shaders_dir, :out_dir] do |_task, args|
    shaders_dir = args[:shaders_dir]
    out_dir = args[:out_dir]
    if !shaders_dir || !out_dir
      abort "usage: rake glslkit:embed[shaders_dir,out_dir]"
    end

    # 警告の標準エラー出力はGlslkit::WebGL::Embed.generate自身が行う
    # (rakeタスク経由でなくても見えるようにするため)。ここで二重には出さない。
    results = Glslkit::WebGL::Embed.generate(shaders_dir: shaders_dir, out_dir: out_dir)
    results.each { |result| puts "wrote #{result.fetch(:path)}" }
  end
end
